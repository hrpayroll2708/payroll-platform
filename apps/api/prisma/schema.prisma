datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum EmploymentStatus {
  DRAFT
  ACTIVE
  PROBATION
  NOTICE_PERIOD
  TERMINATED
  RESIGNED
  RETIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ComponentCategory {
  EARNING
  DEDUCTION
  STATUTORY_EMPLOYEE
  STATUTORY_EMPLOYER
  REIMBURSEMENT
}

enum CalculationType {
  FLAT
  PERCENTAGE
  FORMULA
}

enum PayrollStatus {
  DRAFT
  PROCESSING
  REVIEW
  APPROVED
  FINALIZED
  DISBURSED
  VOID
}

enum TaxRegime {
  OLD
  NEW_115BAC
}

model Tenant {
  id         String       @id @default(uuid())
  slug       String       @unique
  name       String
  status     TenantStatus @default(ACTIVE)
  created_at DateTime     @default(now())

  companies    Company[]
  employees    Employee[]
  payroll_runs PayrollRun[]

  @@map("tenants")
}

model Company {
  id           String   @id @default(uuid())
  tenant_id    String
  legal_name   String
  pan_hash     String
  tan          String
  created_at   DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  employees    Employee[]
  payroll_runs PayrollRun[]

  @@map("companies")
}

model Employee {
  id              String           @id @default(uuid())
  tenant_id       String
  company_id      String
  employee_code   String
  first_name      String
  last_name       String
  gender          Gender
  date_of_joining DateTime         @db.Date
  status          EmploymentStatus @default(ACTIVE)
  pan_hash        String           @default("SAMPLE_PAN")
  created_at      DateTime         @default(now())

  tenant            Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  company           Company           @relation(fields: [company_id], references: [id], onDelete: Restrict)
  payroll_employees PayrollEmployee[]

  @@unique([company_id, employee_code])
  @@map("employees")
}

model PayrollRun {
  id               String        @id @default(uuid())
  tenant_id        String
  company_id       String
  payroll_month    Int
  payroll_year     Int
  total_gross      Decimal       @default(0.00) @db.Decimal(14, 2)
  total_deductions Decimal       @default(0.00) @db.Decimal(14, 2)
  total_net        Decimal       @default(0.00) @db.Decimal(14, 2)
  status           PayrollStatus @default(DRAFT)
  created_at       DateTime      @default(now())

  tenant            Tenant            @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  company           Company           @relation(fields: [company_id], references: [id], onDelete: Restrict)
  payroll_employees PayrollEmployee[]

  @@unique([company_id, payroll_month, payroll_year])
  @@map("payroll_runs")
}

model PayrollEmployee {
  id               String   @id @default(uuid())
  payroll_run_id   String
  employee_id      String
  paid_days        Decimal  @db.Decimal(4, 2)
  lop_days         Decimal  @db.Decimal(4, 2)
  earned_gross     Decimal  @db.Decimal(12, 2)
  total_deductions Decimal  @db.Decimal(12, 2)
  net_pay          Decimal  @db.Decimal(12, 2)
  created_at       DateTime @default(now())

  payroll_run PayrollRun @relation(fields: [payroll_run_id], references: [id], onDelete: Cascade)
  employee    Employee   @relation(fields: [employee_id], references: [id], onDelete: Restrict)

  @@unique([payroll_run_id, employee_id])
  @@map("payroll_employees")
}
